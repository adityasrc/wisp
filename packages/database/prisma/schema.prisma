// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String               @id @default(uuid())
  createdAt         DateTime             @default(now())
  name              String
  username          String               @unique
  password          String
  bio               String?
  avatarType        AvatarType           @default(GENERATED)
  avatarUrl         String?
  messages          Message[]
  sentRequest       ChatRequest[]        @relation("Sent")
  receivedRequest   ChatRequest[]        @relation("Received")
  conversation      ConversationMember[]
  reservedUsernames ReservedUsername[]
}

model ReservedUsername {
  id        String   @id @default(uuid(7))
  userId    String
  username  String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatRequest {
  id         String        @id @default(uuid())
  senderId   String
  receiverId String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  message    String?
  sender     User          @relation("Sent", fields: [senderId], references: [id])
  receiver   User          @relation("Received", fields: [receiverId], references: [id])
}

model Conversation {
  id             String               @id @default(uuid())
  type           ConversationType     @default(DM)
  createdAt      DateTime             @default(now())
  lastActivityAt DateTime             @default(now())
  isDormant      Boolean              @default(false)
  message        Message[]
  member         ConversationMember[]
}

model ConversationMember {
  conversationId String
  userId         String
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id])
  conversation   Conversation     @relation(fields: [conversationId], references: [id])

  @@id([userId, conversationId])
}

model Message {
  id             String       @id @default(uuid(7))
  senderId       String
  conversationId String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lifespan       LifespanType @default(NORMAL)
  expiresAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

enum ConversationType {
  DM
  GROUP
  CHANNEL
}

enum ConversationRole {
  ADMIN
  MEMBER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AvatarType {
  GENERATED
  UPLOADED
}

enum LifespanType {
  NORMAL
  SENSITIVE
}
